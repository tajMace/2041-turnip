#!/usr/bin/env dash

# COMP2041 Turnip - turnip-summary command for the turnip assignment program
# turnip-summary
#
# Lists all assignments, with a count of how many students have made submissions.

# ----- main script -----
main() {
  DIR="./.turnip"

  if [ ! -d "$DIR" ]; then
    echo "turnip-summary: nothing to summarise" >&2
    exit 1
  fi

  if ! find "$DIR" -mindepth 1 -maxdepth 1 -type d | read -r _; then
    echo "no assignments"
    exit 1
  fi

  for directory in "$DIR"/*; do
    [ -e "$directory" ] || continue
    [ -d "$directory" ] || continue

    assignment_name=${directory##*/}
    submission_count=$(find "$directory" -mindepth 1 -maxdepth 1 -type d -name 'z[0-9][0-9][0-9][0-9][0-9][0-9][0-9]' | wc -l)

    echo "assignment $assignment_name: submissions from $submission_count students"
  done
}

# ----- run script -----
main