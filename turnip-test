#
# turnip-test runs the tests supplied to students for an assignment on a program.

# ============================
# ----- helper functions -----
# ============================

# checks ONLY two arguments were given
validate_argument_count() {
    if [ "$1" -ne 2 ]; then
        echo "usage: turnip-test <assignment> <filename>" >&2
        exit 1
    fi
}

# checks assignment name corresponds to the following criteria:
# "Assignment names must start with a lowercase letter ([a-z]),
# and be followed only by letters, number and underscore ([a-zA-Z0-9_])"
#
# then checks if the assignment exists
validate_assignment() {
    if ! echo "$1" | grep -qE '^[a-z][a-zA-Z0-9_]*$'; then
        echo "turnip-test: invalid assignment: $1" >&2
        exit 1
    fi

    if ! [ -d "./.turnip/$1" ]; then
        echo "turnip-test: assignment $1 not found" >&2
        exit 1
    fi
}

# checks filename corresponds to the following criteria:
# "The filename should only contain letters ([a-zA-Z]), numbers ([0-9]),
# underscore ('_'), dash ('-'), dot ('.') and slash ('/')."
#
# then checks if a file exists at the given path
validate_target_file() {
    if ! echo "$1" | grep -qE '^[a-zA-Z0-9_./-]+$'; then
        echo "turnip-test: invalid filename: $1" >&2
        exit 1
    fi

    if ! [ -f "$1" ]; then
        echo "turnip-test: $1: No such file or directory" >&2
        exit 1
    fi
}

# helper to run checks on given arguments
validate_arguments() {
    validate_argument_count "$#"
    validate_assignment "$1"
    validate_target_file "$2"
}

# checks if a test directory contains a 'marks' file
# returns 1 if true, or 0 if false
check_for_marks_file() {
    _test_dir="$1"

    if [ -f "$_test_dir/marks" ]; then
        return 1
    fi

    return 0
}

# retrieves contents of the arguments file if it exists, otherwise returns empty
get_arguments_from_file() {
    _test_filepath="$1"

    if [ -f "$_test_filepath" ]; then
        cat "$_test_filepath"
    else
        echo ""
    fi
}

# retrieves contents of the exit_status file if it exists, otherwise defaults to 0
get_exit_status_from_file() {
    _test_dir="$1"

    if [ -f "$_test_dir/exit_status" ]; then
        cat "$_test_dir/exit_status"
    else
        echo "0"
    fi
}

# applies options to submission stdout for comparison
# fills new stdout into a temporary destination file
normalise_for_comparison() {
    _src="$1"
    _options="$2"
    _dst="$3"

    # if no stdout, pipe nothing into destination
    if ! [ -s "$_src" ]; then
        : > "$_dst"
        return
    fi

    # copy exactly, preserving all bytes including all newlines
    cp "$_src" "$_dst"

    # option b: "differences regarding empty lines should be ignored"
    if echo "$_options" | grep -q "b"; then
        sed '/^[[:space:]]*$/d' < "$_dst" > "$_dst.tmp"
        mv "$_dst.tmp" "$_dst"
    fi

    # option c: "differences in case (uppercase versus lowercase) should be ignored"
    if echo "$_options" | grep -q "c"; then
        tr '[:upper:]' '[:lower:]' < "$_dst" > "$_dst.tmp"
        mv "$_dst.tmp" "$_dst"
    fi

    # option d: "differences regarding characters other than [0-9] and '\n' should be ignored"
    if echo "$_options" | grep -q "d"; then
        tr -cd '0-9\n' < "$_dst" > "$_dst.tmp"
        mv "$_dst.tmp" "$_dst"
    fi

    # option w: "differences in space (' ') and tab ('\t') characters should be ignored"
    if echo "$_options" | grep -q "w"; then
        sed 's/[ \t][ \t]*/ /g; s/^[ \t]*//; s/[ \t]*$//' < "$_dst" > "$_dst.tmp"
        mv "$_dst.tmp" "$_dst"
    fi
}

# helper function to print a mismatch report with byte counts and newline safety
# designed for empty file checks
report_empty_mismatch() {
    _msg="$1"
    _file="$2"
    _error="$3"

    _bytes=$(wc -c < "$_file" | tr -d ' ')
    echo "--- $_msg $_bytes bytes $_error:"
    cat "$_file"

    if [ "$(tail -c 1 "$_file" | wc -l)" -eq 0 ]; then
        echo ""
    fi
    echo ""
}

# helper function to print a mismatch report with byte counts and newline safety
# designed for content checks
report_content_mismatch() {
    _msg="$1"
    _file="$2"

    _bytes=$(wc -c < "$_file" | tr -d ' ')
    echo "--- $_msg $_bytes bytes:"
    cat "$_file"

    if [ "$(tail -c 1 "$_file" | wc -l)" -eq 0 ]; then
        echo ""
    fi
    echo ""
}

# helper function to check and report a newline mismatch
# returns 0 if a newline mismatch was detected and reported, 1 otherwise
report_newline_mismatch() {
    _file_a="$1"
    _file_b="$2"
    _message="$3"
    _stream="$4"

    # create temp file with additional newline at EOF
    _tmp_plus_nl=$(mktemp)
    cp "$_file_a" "$_tmp_plus_nl"
    printf '\n' >> "$_tmp_plus_nl"

    # compare for newline mismatch, printing error if true
    if cmp -s "$_tmp_plus_nl" "$_file_b"; then
        echo "$_message newline at end of $_stream"
        rm -f "$_tmp_plus_nl"
        return 0
    fi

    rm -f "$_tmp_plus_nl"
    return 1
}

# compares actual vs expected output for one stream (stdout or stderr)
# prints failure details and returns 1 on failure, 0 on pass
check_stream() {
    _stream="$1"
    _actual="$2"
    _expected="$3"
    _options="$4"

    _actual_empty=false
    _expected_empty=false
    if ! [ -s "$_actual" ]; then _actual_empty=true; fi
    if ! [ -s "$_expected" ]; then _expected_empty=true; fi

    # --- empty failure cases ---
    # success case: expected nothing, output nothing
    if [ "$_actual_empty" = true ] && [ "$_expected_empty" = true ]; then
        return 0
    fi

    # fail case: expected something and received nothing
    if [ "$_actual_empty" = true ]; then
        report_empty_mismatch "No $_stream produced, these" "$_expected" "expected"
        return 1
    fi

    # fail case: expected nothing and received something
    if [ "$_expected_empty" = true ]; then
        report_empty_mismatch "No $_stream expected, these" "$_actual" "produced"
        return 1
    fi

    # --- apply options and exact match check ---
    _tmp_actual=$(mktemp)
    _tmp_expected=$(mktemp)
    normalise_for_comparison "$_actual" "$_options" "$_tmp_actual"
    normalise_for_comparison "$_expected" "$_options" "$_tmp_expected"

    # success case: files are the same after applying options
    if cmp -s "$_tmp_actual" "$_tmp_expected"; then
        rm -f "$_tmp_actual" "$_tmp_expected"
        return 0
    fi

    # --- newline failure cases ---
    # fail case: missing newline at EOF
    if report_newline_mismatch "$_tmp_actual" "$_tmp_expected" "Missing" "$_stream"; then
        rm -f "$_tmp_actual" "$_tmp_expected"
        return 1
    fi

    # fail case: additional newline at EOF
    if report_newline_mismatch "$_tmp_expected" "$_tmp_actual" "Extra" "$_stream"; then
        rm -f "$_tmp_actual" "$_tmp_expected"
        return 1
    fi

    # output is wrong, no need for temp files anymore
    rm -f "$_tmp_actual" "$_tmp_expected"

    # --- incorrect raw output ---
    report_content_mismatch "Incorrect $_stream of" "$_actual"
    report_content_mismatch "Correct $_stream is these" "$_expected"

    return 1
}

# executes a single test case
run_single_test() {
    _test_path="$1"
    _filename="$2"

    # extract metadata from test directory
    test_name=$(basename "$_test_path")
    arguments=$(get_arguments_from_file "$_test_path/arguments")
    options=$(get_arguments_from_file "$_test_path/options")
    expected_status=$(get_exit_status_from_file "$_test_path")

    tmp_stdout=$(mktemp)
    tmp_stderr=$(mktemp)

    # word splitting required to parse command-line arguments
    if [ -f "$_test_path/stdin" ]; then
        "$_filename" $arguments < "$_test_path/stdin" >"$tmp_stdout" 2>"$tmp_stderr"
    else
        "$_filename" $arguments >"$tmp_stdout" 2>"$tmp_stderr"
    fi

    # capture exit status
    actual_status=$?

    stdout_expected="$_test_path/stdout"
    stderr_expected="$_test_path/stderr"

    if ! [ -f "$stdout_expected" ]; then
        stdout_expected="/dev/null"
    fi

    if ! [ -f "$stderr_expected" ]; then
        stderr_expected="/dev/null"
    fi
}

# compares the actual test results (stdout, stderr, status) against expected values
# returns 0 if all match, else returns 1
compare_test_results() {
    _tmp_stdout="$1"
    _stdout_expected="$2"
    _stdout_output="$3"

    _tmp_stderr="$4"
    _stderr_expected="$5"
    _stderr_output="$6"

    _actual_status="$7"
    _expected_status="$8"
    _options="$9"

    _all_ok=true

    if ! check_stream "stdout" "$_tmp_stdout" "$_stdout_expected" "$_options" >"$_stdout_output" 2>&1; then
        _all_ok=false
    fi

    if ! check_stream "stderr" "$_tmp_stderr" "$_stderr_expected" "$_options" >"$_stderr_output" 2>&1; then
        _all_ok=false
    fi

    if [ "$_actual_status" -ne "$_expected_status" ]; then
        _all_ok=false
    fi

    # comparison finished, remove temp files
    rm -f "$_tmp_stdout" "$_tmp_stderr"

    [ "$_all_ok" = true ] && return 0
    return 1
}

# prints the success message for a passing test
print_test_success() {
    _test_name="$1"

    echo "* Test $_test_name passed."
}

# prints the failure message for a failing test
# includes the incorrect stdout, stderr or exit status
print_test_fail() {
    _test_name="$1"
    _stdout_log="$2"
    _stderr_log="$3"
    _actual_status="$4"
    _expected_status="$5"

    echo "* Test $_test_name failed."

    # print captured stdout/stderr if they exist
    [ -f "$_stdout_log" ] && cat "$_stdout_log"
    [ -f "$_stderr_log" ] && cat "$_stderr_log"

    # print status mismatch if incorrect
    if [ "$_actual_status" -ne "$_expected_status" ]; then
        echo "Exit status of $_actual_status incorrect should be $_expected_status"
    fi
}

# processes a single test, checking stdout, stderr, and exit status
# updates pass/fail count
process_test() {
    _test_path="$1"
    _submission="$2"

    run_single_test "$_test_path" "$_submission"

    _stdout_output=$(mktemp)
    _stderr_output=$(mktemp)

    if compare_test_results "$tmp_stdout" "$stdout_expected" "$_stdout_output" \
                            "$tmp_stderr" "$stderr_expected" "$_stderr_output" \
                            "$actual_status" "$expected_status" "$options"; then
        print_test_success "$test_name"
        pass_count=$((pass_count + 1))
    else
        print_test_fail "$test_name" "$_stdout_output" "$_stderr_output" \
                        "$actual_status" "$expected_status"
        fail_count=$((fail_count + 1))
    fi

    rm -f "$_stdout_output" "$_stderr_output"
}

# prints the final summary for a submission
print_submission_footer() {
    _pass_count="$1"
    _fail_count="$2"

    echo "** $_pass_count tests passed, $_fail_count tests failed"
}

# runs all tests on a single submission, printing the footer with sum total
test_single_submission() {
    _submission="$1"

    pass_count=0
    fail_count=0

    for test_name in $(ls "$TEST_DIR" | sort); do
        test_path="$TEST_DIR/$test_name"

        if ! [ -d "$test_path" ]; then
            continue
        fi

        check_for_marks_file "$test_path" || continue

        process_test "$test_path" "$_submission"
    done

    print_submission_footer "$pass_count" "$fail_count"
}

# =========================
# ----- main function -----
# =========================
main() {
    validate_arguments "$@"

    ASSIGNMENT="$1"
    SUBMISSION="$2"
    TEST_DIR="./.turnip/$ASSIGNMENT/tests"

    test_single_submission "$SUBMISSION"
}

# ======================
# ----- run script -----
# ======================
main "$@"